---
import { Image } from "astro:assets";
import me from "../assets/me.jpeg";
---

<Image
  src={me}
  alt="Robert Soriano"
  width={160}
  height={160}
  densities={[1, 2]}
  loading="eager"
  class="mx-auto mb-10 block size-40 rounded-full bg-line object-cover grayscale transition duration-300 hover:grayscale-0 sm:float-right sm:mb-6 sm:ml-8 sm:mt-1"
/>
