---
interface Props {
  title?: string;
  description?: string;
}

import { metaData } from "../config";
import { SEO } from "astro-seo";

const { title, description = metaData.description } = Astro.props;

const { url } = Astro;
const openGraphImage = new URL(metaData.ogImage, Astro.site).href;
---

<SEO
  title={title}
  titleTemplate={`%s | ${metaData.title}`}
  titleDefault={metaData.title}
  description={description}
  charset="UTF-8"
  openGraph={{
    basic: {
      title: title || metaData.title,
      type: "website",
      image: openGraphImage,
      url: url,
    },
    optional: {
      description,
      siteName: metaData.title,
      locale: "en_US",
    },
  }}
  twitter={{
    card: "summary_large_image",
    title: title || metaData.title,
    description,
    image: openGraphImage,
    creator: "@wobsoriano",
  }}
  extend={{
    link: [{ rel: "icon", href: "/favicon.svg", type: "image/svg+xml" }],
    meta: [
      { name: "theme-color", content: "#ffffff", media: "(prefers-color-scheme: light)" },
      { name: "theme-color", content: "#121212", media: "(prefers-color-scheme: dark)" },
    ],
  }}
/>
