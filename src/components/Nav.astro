---
import { metaData } from "../config";

const navItems = [
  { href: "/projects", name: "Projects" },
  { href: "/uses", name: "Uses" },
];

const host = new URL(metaData.baseUrl).host;
const path = Astro.url.pathname.replace(/\/$/, "");
---

<nav class="mb-16 flex items-center justify-between gap-6 py-2 sm:mb-20">
  <a href="/" class="text-lg font-semibold tracking-tight text-ink" aria-current={path === "" ? "page" : undefined}>
    {host}
  </a>
  <div class="flex items-center gap-5 text-muted">
    {
      navItems.map(({ href, name }) => (
        <a
          href={href}
          class="transition-colors hover:text-ink aria-[current=page]:text-ink"
          aria-current={path === href ? "page" : undefined}>
          {name}
        </a>
      ))
    }
    <button
      type="button"
      data-theme-toggle
      aria-label="Switch to dark theme"
      class="-m-2 grid size-9 place-items-center rounded-full transition-colors hover:text-ink">
      <svg viewBox="0 0 16 16" class="size-[15px]" aria-hidden="true">
        <circle cx="8" cy="8" r="6.75" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
        <path d="M8 1.25a6.75 6.75 0 0 1 0 13.5z" fill="currentColor"></path>
      </svg>
    </button>
  </div>
</nav>

<script>
  const label = (button: Element) => {
    const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    button.setAttribute("aria-label", `Switch to ${next} theme`);
  };

  document.addEventListener("astro:page-load", () => {
    const button = document.querySelector("[data-theme-toggle]");
    if (!button) return;
    label(button);
    button.addEventListener("click", () => {
      const root = document.documentElement;
      const theme = root.dataset.theme === "dark" ? "light" : "dark";
      root.dataset.theme = theme;
      try {
        localStorage.setItem("theme", theme);
      } catch {}
      label(button);
      document.dispatchEvent(new CustomEvent("theme-change", { detail: theme }));
    });
  });
</script>
