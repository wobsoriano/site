---
import Base from "../layouts/Base.astro";
import { uses } from "../config";
---

<Base title="Uses" description="The editor, terminal, apps and hardware Robert Soriano uses every day.">
  <h1 class="mb-3 text-3xl font-semibold tracking-tight text-ink sm:text-4xl">Some of what I use</h1>
  <p class="mb-12 text-muted">The editor, terminal, apps and hardware I reach for every day.</p>
  <div class="space-y-12">
    {
      uses.map((group) => (
        <section aria-labelledby={`uses-${group.heading.toLowerCase()}`}>
          <h2 id={`uses-${group.heading.toLowerCase()}`} class="mb-3 text-lg font-semibold tracking-tight text-ink">
            {group.heading}
          </h2>
          <ul class="divide-y divide-line border-y border-line">
            {group.items.map((item) => (
              <li class="flex items-baseline justify-between gap-6 py-3">
                {item.link ? (
                  <a href={item.link} target="_blank" rel="noopener noreferrer" class="link font-medium text-ink">
                    {item.name}
                  </a>
                ) : (
                  <span class="font-medium text-ink">{item.name}</span>
                )}
                <span class="text-right text-muted">{item.description}</span>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Base>
