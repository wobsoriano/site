---
import Base from "../layouts/Base.astro";
import Portrait from "../components/Portrait.astro";
import ProjectList from "../components/ProjectList.astro";
import { getProjects } from "../lib/stars";

const projects = (await getProjects()).slice(0, 5);
---

<Base>
  <section class="flow-root">
    <Portrait />
    <h1 class="mb-6 text-3xl font-semibold tracking-tight text-ink sm:text-4xl">Hi, I'm Robert!</h1>
    <p class="text-pretty">
      I work as a <strong class="font-semibold text-ink">Software Engineer</strong> at
      <a href="https://clerk.com" target="_blank" rel="noopener noreferrer" class="link">Clerk</a>, building the SDKs
      developers and agents use to add auth to their apps. I'm always exploring frontend and backend tooling to make the developer
      experience better.
    </p>
  </section>

  <section class="mt-16" aria-labelledby="projects-heading">
    <div class="mb-4 flex items-baseline justify-between gap-4">
      <h2 id="projects-heading" class="text-lg font-semibold tracking-tight text-ink">Projects</h2>
      <a href="/projects" class="text-sm text-muted transition-colors hover:text-ink">See all</a>
    </div>
    <ProjectList projects={projects} />
  </section>
</Base>
